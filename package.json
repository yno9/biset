{
  "name": "biset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:app && pnpm build:sw",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.mediator.json && tsc --noEmit -p tsconfig.mimi.json && tsc --noEmit -p tsconfig.rp-signer.json && tsc --noEmit -p tsconfig.vite.json",
    "build:didcomm-mediator": "esbuild src/server/mediator/index.ts --bundle --platform=node --format=esm --target=node26 --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist-server/didcomm-mediator.mjs",
    "build:mediator": "pnpm build:didcomm-mediator",
    "build:mimi": "esbuild src/server/mimi/index.ts --bundle --platform=node --format=esm --target=node26 --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist-server/mimi.mjs",
    "didcomm-mediator": "pnpm build:didcomm-mediator && node dist-server/didcomm-mediator.mjs",
    "mediator": "pnpm didcomm-mediator",
    "rp-signer": "node src/server/rp-signer/index.ts",
    "smoke:didcomm-mediator": "esbuild scripts/didcomm-mediator-smoke.ts --bundle --platform=node --format=esm --target=node26 --log-level=warning --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist-server/smoke.mjs && node dist-server/smoke.mjs",
    "test": "vitest run",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm knip && pnpm reachability --quiet && pnpm test",
    "reachability": "node scripts/reachability.mjs",
    "build:app": "vite build",
    "build:sw": "esbuild src/client/app/sw.ts --bundle --outfile=dist/sw.js --platform=browser --format=iife --target=es2022 --minify-syntax --minify-whitespace"
  },
  "devDependencies": {
    "@hpke/core": "1.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "didcomm-node": "^0.4.1",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "knip": "^6.27.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "openpgp": "^6.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.0.0",
    "ws": "^8.18.0",
    "yjs": "13.6.27"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  }
}
