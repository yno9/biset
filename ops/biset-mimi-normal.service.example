[Unit]
Description=Biset MIMI provider (normal mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=biset-mimi-normal
StateDirectoryMode=0700
EnvironmentFile=/etc/biset/mimi-normal.env
ExecStart=/opt/biset/mimi/biset-mimi
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
