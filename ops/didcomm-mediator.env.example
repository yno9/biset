MEDIATOR_PUBLIC_URL=https://mediator.example.com
MEDIATOR_DATABASE_PATH=/var/lib/biset-didcomm-mediator/mediator.sqlite
MEDIATOR_HOST=127.0.0.1
PORT=8791
# `null` permits packaged/local `file://` biset-ui builds. The mediator
# still authenticates coordinate/pickup operations with DIDComm authcrypt;
# CORS is not an authentication boundary.
# `app.did.md` is the Wallet's authorization UI. It verifies a Biset
# device's Mediator DID document before approving a second device.
MEDIATOR_ALLOWED_ORIGINS=https://t.biset.md,https://app.did.md,null
MEDIATOR_RATE_LIMIT_PER_MINUTE=3000

MEDIATOR_MAX_REQUEST_BYTES=2097152
MEDIATOR_MAX_MESSAGE_BYTES=1048576
MEDIATOR_MAX_QUEUE_ITEMS=256
MEDIATOR_MAX_QUEUE_BYTES=16777216
MEDIATOR_QUEUE_TTL_MS=2592000000
MEDIATOR_REPLAY_TTL_MS=600000
MEDIATOR_MAX_REPLAY_IDS=50000
MEDIATOR_MAX_CONNECTIONS=10000
MEDIATOR_MAX_KEYS_PER_CONNECTION=32
