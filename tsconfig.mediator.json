{
  // The standalone mediator (src/mediator/) is its own Bun server deploy
  // unit, same reasoning as tsconfig.core.json: no DOM lib, so it physically
  // cannot reach for `localStorage`/`indexedDB`, and `include` is the entry
  // tree only -- whatever it imports from `didcomm/` gets checked under
  // these same (DOM-less) rules, which is what proves it stays free of
  // biset-core/roster/vault coupling (server.ts's own header comment).
  //
  // `mail-plugin/` is excluded on purpose: it's the mediator+mail-plugin
  // deploy (this project's own "B", the A/B mediator split), a genuinely
  // separate deploy unit that DOES reuse core/adapters/mail-smtp-protocol.ts
  // -- checked instead under tsconfig.mail-plugin.json, so this project keeps
  // proving the blind mediator (server.ts, "A") never gains that coupling.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "types": ["bun"]
  },
  "include": ["src/mediator/**/*"],
  "exclude": ["src/mediator/mail-plugin/**"],
  "typeRoots": ["node_modules/@types"]
}
